      "const": false
    },
    "standards_review": {
      "const": "NOT_EVALUATED"
    },
    "fengshui_review": {
      "const": "NOT_EVALUATED"
    },
    "contract": {
      "const": "stair-drafting-v1"
    },
    "drafting_status": {
      "enum": [
        "GENERATED",
        "INVALID_INPUT",
        "INCOMPLETE",
        "CONFLICT",
        "UNSUPPORTED"
      ]
    },
    "geometry_status": {
      "enum": [
        "VALID",
        "INVALID",
        "NOT_GENERATED"
      ]
    },
    "source_opening_revision_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "source_candidate_digest": {
      "type": [
        "string",
        "null"
      ]
    },
    "specification_digest": {
      "type": [
        "string",
        "null"
      ]
    },
    "stair_revision_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "frame_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "datum": {
      "type": [
        "string",
        "null"
      ]
    },
    "units": {
      "const": "m"
    },
    "stairs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/stair"
