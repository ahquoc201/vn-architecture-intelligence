{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "report_schema_version": {
      "type": "integer",
      "const": 1
    },
    "engine_version": {
      "type": "string",
      "pattern": "\\S"
    },
    "status": {
      "enum": [
        "VALID",
        "INVALID",
        "INCOMPLETE"
      ]
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string",
            "pattern": "\\S"
          },
          "path": {
            "type": "string"
          },
          "message": {
            "type": "string",
            "pattern": "\\S"
          },
          "requirement_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "\\S"
            },
            "minItems": 0
          }
        },
        "required": [
          "code",
          "path",
          "message",
          "requirement_ids"
        ]
      },
      "minItems": 0
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string",
            "pattern": "\\S"
          },
          "path": {
            "type": "string"
          },
          "message": {
            "type": "string",
            "pattern": "\\S"
          },
          "requirement_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "\\S"
            },
            "minItems": 0
          }
        },
        "required": [
          "code",
          "path",
          "message",
          "requirement_ids"
        ]
      },
      "minItems": 0
    },
    "missing_information": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string",
            "pattern": "\\S"
          },
          "path": {
            "type": "string"
          },
          "message": {
            "type": "string",
            "pattern": "\\S"
          },
          "requirement_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "\\S"
            },
            "minItems": 0
          }
        },
        "required": [
          "code",
          "path",
          "message",
          "requirement_ids"
        ]
      },
      "minItems": 0
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string",
            "pattern": "\\S"
          },
          "path": {
            "type": "string"
          },
          "message": {
            "type": "string",
            "pattern": "\\S"
          },
          "requirement_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "\\S"
            },
            "minItems": 0
          }
        },
        "required": [
          "code",
          "path",
          "message",
          "requirement_ids"
        ]
      },
      "minItems": 0
