    "floor_openings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "stair_id": {
            "type": "string"
          },
          "destination_floor": {
            "type": "string"
          },
          "opening_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "slab_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "status": {
            "enum": [
              "MODELED",
              "INCOMPLETE"
            ]
          }
        },
        "required": [
          "stair_id",
          "destination_floor",
          "opening_ids",
          "slab_ids",
          "status"
        ]
      }
    },
    "headroom": {
      "anyOf": [
        {
          "type": "object",
          "maxProperties": 0
        },
        {
          "$ref": "#/$defs/headroom"
        }
      ]
    },
    "circulation": {
      "anyOf": [
        {
          "type": "object",
          "maxProperties": 0
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "stairs": {
              "$ref": "stair-result.schema.json"
            },
            "graph": {
              "$ref": "circulation-graph.schema.json"
            },
            "geometry_validity": {
              "type": "string"
            },
            "clearance_status": {
              "type": "string"
            },
            "physical_status": {
              "enum": [
                "NOT_VERIFIED",
                "BLOCKED",
                "GEOMETRICALLY_TRAVERSABLE"
              ]
            },
            "technical_compliance": {
              "const": "NOT_EVALUATED"
            },
            "architectural_approval": {
              "const": "NOT_GRANTED"
            },
            "scope": {
              "type": "string"
            }
          },
          "required": [
            "stairs",
            "graph",
            "geometry_validity",
            "clearance_status",
            "physical_status",
            "technical_compliance",
            "architectural_approval",
            "scope"
          ]
        }
      ]
    },
    "schedule": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
