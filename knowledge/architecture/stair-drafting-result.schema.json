                "id",
                "risers",
                "ordinary_treads",
                "riser_height_m",
                "last_riser_height_m",
                "riser_height_origin",
                "tread_depth_m",
                "width_m",
                "run_m",
                "pitch_degrees"
              ]
            }
          },
          "landings": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "id": {
                  "type": "string"
                },
                "elevation_m": {
                  "type": "number"
                },
                "dimensions_m": {
                  "type": "array",
                  "items": {
                    "type": "number"
                  },
                  "minItems": 2,
                  "maxItems": 2
                },
                "elevation_origin": {
                  "type": "string"
                }
              },
              "required": [
                "id",
                "elevation_m",
                "dimensions_m",
                "elevation_origin"
              ]
            }
          },
          "opening_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "headroom_status": {
            "type": "string"
          },
          "minimum_verified_headroom_m": {
            "type": [
              "number",
              "null"
            ]
          },
          "provenance": {
            "type": "string"
          },
          "unresolved_codes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "id",
          "mark",
          "type",
          "source_floor",
          "destination_floor",
          "source_elevation_m",
          "destination_elevation_m",
          "rise_m",
          "final_elevation_m",
          "closure_residual_m",
          "review_status",
          "flights",
          "landings",
          "opening_ids",
          "headroom_status",
          "minimum_verified_headroom_m",
          "provenance",
          "unresolved_codes"
        ]
