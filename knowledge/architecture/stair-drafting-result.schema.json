            "type": "number"
          },
          "destination_elevation_m": {
            "type": "number"
          },
          "rise_m": {
            "type": "number"
          },
          "final_elevation_m": {
            "type": "number"
          },
          "closure_residual_m": {
            "type": "number"
          },
          "review_status": {
            "const": "PROPOSED"
          },
          "flights": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "id": {
                  "type": "string"
                },
                "risers": {
                  "type": "integer",
                  "minimum": 0
                },
                "ordinary_treads": {
                  "type": "integer",
                  "minimum": 0
                },
                "riser_height_m": {
                  "type": "number"
                },
                "last_riser_height_m": {
                  "type": "number"
                },
                "riser_height_origin": {
                  "type": "string"
                },
                "tread_depth_m": {
                  "type": "number"
                },
                "width_m": {
                  "type": "number"
