{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "report_schema_version": {
      "type": "integer",
      "const": 1
    },
    "engine_version": {
      "type": "string",
      "pattern": "\\S"
    },
    "contract": {
      "type": "string",
      "pattern": "\\S"
    },
    "status": {
      "enum": [
        "VALID",
        "INVALID",
        "INCOMPLETE"
      ]
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string",
            "pattern": "\\S"
          },
          "path": {
            "type": "string"
          },
          "message": {
            "type": "string",
            "pattern": "\\S"
          },
          "requirement_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "\\S"
            },
            "minItems": 0,
            "maxItems": 128
          }
        },
        "required": [
          "code",
          "path",
          "message",
          "requirement_ids"
        ]
      },
      "minItems": 0,
      "maxItems": 10000
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string",
            "pattern": "\\S"
          },
          "path": {
            "type": "string"
          },
          "message": {
            "type": "string",
            "pattern": "\\S"
          },
          "requirement_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "\\S"
            },
            "minItems": 0,
            "maxItems": 128
          }
        },
        "required": [
          "code",
          "path",
          "message",
          "requirement_ids"
        ]
      },
      "minItems": 0,
      "maxItems": 10000
    },
    "missing_information": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string",
            "pattern": "\\S"
          },
          "path": {
            "type": "string"
          },
          "message": {
            "type": "string",
            "pattern": "\\S"
          },
          "requirement_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "\\S"
            },
            "minItems": 0,
            "maxItems": 128
          }
        },
        "required": [
          "code",
          "path",
          "message",
          "requirement_ids"
        ]
      },
      "minItems": 0,
      "maxItems": 10000
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string",
            "pattern": "\\S"
          },
          "path": {
            "type": "string"
          },
          "message": {
            "type": "string",
            "pattern": "\\S"
          },
          "requirement_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "\\S"
            },
            "minItems": 0,
            "maxItems": 128
          }
        },
        "required": [
          "code",
          "path",
          "message",
          "requirement_ids"
        ]
      },
      "minItems": 0,
      "maxItems": 10000
    },
    "cad_writes_permitted": {
      "const": false
    },
    "standards_review": {
      "const": "NOT_EVALUATED"
    },
    "fengshui_review": {
      "const": "NOT_EVALUATED"
    },
    "candidate_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "candidate_digest": {
      "type": [
        "string",
        "null"
      ]
    },
    "design_digest": {
      "type": [
        "string",
        "null"
      ]
    },
    "graph_status": {
      "enum": [
        "GRAPH_CONNECTED",
        "NOT_VERIFIED",
        "BLOCKED"
      ]
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "\\S"
          },
          "kind": {
            "enum": [
              "room",
              "circulation",
              "stairwell",
              "exterior"
            ]
          },
          "floor_id": {
            "type": "string",
            "pattern": "\\S"
          },
          "geometry_id": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "id",
          "kind",
          "floor_id",
          "geometry_id"
        ]
      },
      "minItems": 0,
      "maxItems": 1024
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "\\S"
          },
          "kind": {
            "enum": [
              "opening",
              "stair"
            ]
          },
          "space_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "\\S"
            },
            "minItems": 2,
            "maxItems": 2
          },
          "physical_state": {
            "enum": [
              "GEOMETRICALLY_TRAVERSABLE",
              "NOT_VERIFIED",
              "BLOCKED"
            ]
          }
        },
        "required": [
          "id",
          "kind",
          "space_ids",
          "physical_state"
        ]
      },
      "minItems": 0,
      "maxItems": 512
    },
    "components": {
      "type": "array",
      "items": {
        "type": "array",
        "items": {
          "type": "string",
          "pattern": "\\S"
        },
        "minItems": 0,
        "maxItems": 1024
      },
      "minItems": 0,
      "maxItems": 1024
    },
    "isolated_room_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "\\S"
      },
      "minItems": 0,
      "maxItems": 1024
    },
    "room_access": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "graph_reachable": {
            "type": "boolean"
          },
          "status": {
            "enum": [
              "GRAPH_CONNECTED",
              "NOT_VERIFIED",
              "BLOCKED"
            ]
          }
        },
        "required": [
          "graph_reachable",
          "status"
        ]
      }
    },
    "entrance_status": {
      "enum": [
        "CONNECTED",
        "MISSING",
        "UNKNOWN"
      ]
    },
    "opening_validation": {
      "type": "object"
    },
    "stair_validation": {
      "type": "object"
    }
  },
  "required": [
    "report_schema_version",
    "engine_version",
    "contract",
    "status",
    "errors",
    "warnings",
    "missing_information",
    "diagnostics",
    "cad_writes_permitted",
    "standards_review",
    "fengshui_review",
    "candidate_id",
    "candidate_digest",
    "design_digest",
    "graph_status",
    "nodes",
    "edges",
    "components",
    "isolated_room_ids",
    "room_access",
    "entrance_status",
    "opening_validation",
    "stair_validation"
  ]
}
